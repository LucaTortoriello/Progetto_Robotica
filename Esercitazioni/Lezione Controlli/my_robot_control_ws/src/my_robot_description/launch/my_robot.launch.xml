<launch>
    <!-- Definizione degli argomenti -->
    <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/my_manipulator.urdf.xacro"/>
    <let name="rviz_config_path" value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>

    <!-- Nodo per pubblicare lo stato del robot -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <!-- Nodo per il Joint State Publisher GUI -->
    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"/>

    <!-- Nodo per avviare RViz con il file di configurazione -->
    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)"/>
</launch>
